{
  "name": "financial-system",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "type": "module",
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "better-sqlite3": "12.9.0",
    "mime": "^2.6.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:python": "python -m backend.main",
    "dev:electron": "wait-on http://localhost:3000 && .\\node_modules\\.bin\\electron.cmd .",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:electron\"",
    "web": "concurrently \"npm run dev:python\" \"npm run dev\"",
    "start": ".\\node_modules\\.bin\\electron.cmd .",
    "build": "set PRISMA_GENERATE_SKIP_AUTOINSTALL=true && set NODE_OPTIONS=--max-old-space-size=8192 && node purge.cjs && next build && node pre-package.cjs",
    "build:python": "powershell ./package_python.ps1",
    "build:all": "npm run build:python && npm run build",
    "dist": "npm run build:all && electron-builder --project dist_standalone",
    "dist:all": "npm run build:all && set NODE_OPTIONS=--max-old-space-size=4096 && electron-builder --win --x64 --ia32 --project dist_standalone",
    "dist:win32": "npm run build:all && set NODE_OPTIONS=--max-old-space-size=4096 && electron-builder --win --ia32 --project dist_standalone",
    "dist:win64": "set NODE_OPTIONS=--max-old-space-size=4096 && electron-builder --win --x64 --project dist_standalone"
  },
  "build": {
    "appId": "com.financial.system",
    "productName": "FinancialSystem",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "build_final_solid"
    },
    "files": [
      "electron.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
